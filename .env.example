# =========================
# LLM client
# =========================

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# ⚠️ 以下四個目前程式碼「沒有」讀取（填了不會有作用），實際生效的是右邊那個：
#   OPENAI_*               → registry.py 尚未定義 openai provider
#   PRIMARY_LLM_PROVIDER   → SPIDERFORGE_GENERATION_PROVIDER（預設 deepseek）
#   FALLBACK_LLM_PROVIDER  → SPIDERFORGE_FINAL_REPAIR_PROVIDER（預設 kimi）
#   DATABASE_URL           → 本專案不寫 DB（persist 只寫檔案）
PRIMARY_LLM_PROVIDER=deepseek
FALLBACK_LLM_PROVIDER=kimi

SPIDERFORGE_GENERATION_PROVIDER=deepseek
SPIDERFORGE_REPAIR_PROVIDER=deepseek
SPIDERFORGE_FINAL_REPAIR_PROVIDER=kimi


# =========================
# local LLM client（Ollama，judge 節點用）
# =========================

OLLAMA_HOST=http://localhost:11434
SPIDERFORGE_JUDGE_MODEL=qwen2.5:7b-instruct


# =========================
# 可觀測性（Arize Phoenix）——沒設 ENDPOINT 就完全不啟用
# =========================

PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=spider_forge
PHOENIX_API_KEY=
# 0 = 只記 token 與耗時，不送 prompt / 模型回覆 / 節點 state 內容
SPIDERFORGE_TRACE_CONTENT=1
SPIDERFORGE_TRACE_MAX_CHARS=4000


# =========================
# 執行行為（可省略，這裡列的都是預設值）
# =========================

# SPIDERFORGE_SITE_QUEUE=examples/site_queue.taiwan-finance.yaml
# SPIDERFORGE_DATA_DIR=runtime
# SPIDERFORGE_TOPIC_MODE=off
# SPIDERFORGE_CRAWLER_RUNTIME=local

